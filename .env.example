# Copy to .env.local for local development. Never commit filled credentials.
# In Vercel, add these in Project Settings > Environment Variables.
OPENAI_API_KEY=
# Verified model ID; change after a small quality/cost evaluation.
OPENAI_MODEL=gpt-5.6-luna
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generate privately: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SALT=
# UTC daily model-call cap; this is NOT a dollar spending limit.
AI_DAILY_REQUEST_LIMIT=100
AI_IP_DAILY_LIMIT=3
AI_MAX_CONCURRENT=4
# Optional comma-separated full origins for an additional custom frontend.
AI_ALLOWED_ORIGINS=
