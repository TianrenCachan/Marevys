# Copy to .env.local for development. Never commit filled credentials.
# Configure Preview and Production separately in the actual Vercel project.
OPENAI_API_KEY=
# Exact model ID your API project can access, supporting Responses + strict JSON Schema.
# No model is silently selected for you.
OPENAI_MODEL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Private random string, >=32 characters. Also the fallback Tarot encryption secret.
# Generate privately: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SALT=
# Optional dedicated Tarot secret, >=32 characters; keep stable across deploys/instances.
# Rotating the active secret invalidates existing draws.
SESSION_SECRET=
# UTC daily model-call cap: a REQUEST limit, not a dollar spending limit.
AI_DAILY_REQUEST_LIMIT=100
# Initial reading, followup and clarifier interpretation each count once.
AI_IP_DAILY_LIMIT=3
AI_MAX_CONCURRENT=4
# Optional full origins for an additional AI/Tarot frontend.
# /api/astrology remains same-origin; use one origin for the full application.
AI_ALLOWED_ORIGINS=
# Local development only: use Redis instead of the in-process ledger.
# Production/Vercel always uses Redis and never falls back to memory.
# TAROT_SESSION_STORAGE=redis
