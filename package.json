{
  "name": "marevys-paris",
  "version": "0.23.0",
  "private": true,
  "description": "MAR\u00c9VYS original tarot, natal and relationship astrology",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "pretest": "node build.cjs",
    "build": "npm run build:web",
    "build:web": "node server/generate-canonical.cjs && node scripts/build-web.cjs",
    "build:offline": "node build.cjs",
    "dev": "node --env-file-if-exists=.env.local scripts/serve-web.cjs",
    "test": "node --test tests/*.test.cjs && node scripts/test-web-build.cjs",
    "check:config": "node --env-file-if-exists=.env.local scripts/check-config.cjs"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "astronomy-engine": "^2.1.19"
  },
  "devDependencies": {
    "jsdom": "^26.1.0"
  }
}
